{
	"name": "cloudflare-email",
	"version": "0.1.4",
	"private": true,
	"description": "Admin log viewer (DataViews) for the Cloudflare Email WordPress plugin.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "rolldown -c rolldown.config.ts",
		"dev": "rolldown -c rolldown.config.ts --watch",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"lint:typecheck": "oxlint --type-aware -c .oxlintrc.typecheck.json .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "npm run format:check && npm run lint && npm run lint:typecheck && npm run typecheck",
		"test:assets": "node tests/playground/run-assets.mjs",
		"test:e2e": "node tests/playground/run-e2e.mjs",
		"test:browser": "node tests/playground/run-browser.mjs",
		"test": "npm run test:assets && npm run test:e2e",
		"upgrade": "npx npm-check-updates -u && npm install"
	},
	"dependencies": {
		"@stylexjs/stylex": "^0.19.1",
		"@wordpress/dataviews": "^19.0.0"
	},
	"devDependencies": {
		"@babel/core": "^8.0.6",
		"@babel/plugin-syntax-jsx": "^8.0.1",
		"@babel/plugin-syntax-typescript": "^8.0.3",
		"@stylexjs/babel-plugin": "^0.19.1",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wordpress/api-fetch": "^7.55.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/dom-ready": "^4.54.0",
		"@wordpress/element": "^8.6.0",
		"@wordpress/i18n": "^6.27.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"rolldown": "^1.2.9",
		"typescript": "^7.0.2"
	}
}
